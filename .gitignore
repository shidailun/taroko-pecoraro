# Local Netlify folder
.netlify

# Raw page scans (huge; archive/pecoraro_taroko_scan.pdf is the compressed backup we keep)
scans/


__pycache__/
scratch_ui_entries.json

# R2 credentials
.env.r2
tools/.env.r2

# Intermediate scratch from the CLAUDE.md -> .claude/notes split; the three
# notes files are the real thing and this would only drift from them.
.claude/notes/sections/

# blockers.py's --cache: one browser render of one verified.js. Committing it
# would put a snapshot of the colours in the history that the next ruling
# falsifies. blockers.md is the artefact; this is the scratch behind it.
tools/orthography/logs/blockers_dom.json

# Scratch instruments. Everything in .scratch/ is disposable EXCEPT the control
# and ledger scripts, which .claude/notes/batch-log.md cites as the evidence a
# batch's rows were checked against -- a citation naming a file that exists on
# one machine is a premise waiting to go false. So: ignore the 43 MB of renders,
# crops and json dumps, track the .py. (Without a rule here a plain `git add -A`
# sweeps in the whole 43 MB, which is why every commit so far has had to say
# `git add -A -- . ':!.scratch'` by hand.)
.scratch/**
!.scratch/**/
!.scratch/**/*.py
